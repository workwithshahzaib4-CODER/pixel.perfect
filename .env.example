ADMIN_USERNAME=pixelperfect
ADMIN_PASSWORD_HASH=$2b$12$replaceWithYourGeneratedBcryptHash
SESSION_SECRET=replace_with_a_strong_session_secret
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/pixel_perfect
ADMIN_NOTIFICATION_WEBHOOK_URL=
# Point this at your WhatsApp Business/automation or email relay webhook.
# The server posts a new-order event with the order ID, customer, total, and timestamp.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v22.0
# Required for automatic customer status messages through WhatsApp Business Cloud API.
